{
  "name": "@game1/iap-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side Google Play purchase verification, idempotent currency/entitlement grants, and refund handling, reusable across games.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "node dist/cli.js migrate",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@googleapis/androidpublisher": "42.2.0",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "google-auth-library": "11.3.1"
  }
}
