# Copy to .env (never commit it) or set these in your hosting platform's secret settings.
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Set when running behind a load balancer, e.g. "true" or a list of proxy CIDRs.
TRUST_PROXY=

DATABASE_URL=postgres://iap:CHANGE_ME@db.internal:5432/iap
DATABASE_POOL_MAX=10
MIGRATE_ON_START=false

IAP_CATALOG_PATH=/etc/iap/catalog.json

# Player sessions. Example values for Firebase Authentication; replace PROJECT_ID.
AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
AUTH_ISSUER=https://securetoken.google.com/PROJECT_ID
AUTH_AUDIENCE=PROJECT_ID
# Deleting a player also deletes their Firebase account. The service account needs the
# Firebase Authentication Admin role in this project.
FIREBASE_PROJECT_ID=PROJECT_ID

# Google Play Developer API credentials come from Application Default Credentials:
# workload identity on Google Cloud, or GOOGLE_APPLICATION_CREDENTIALS pointing at a
# service account key file stored outside the repository.
PLAY_API_TIMEOUT_MS=10000

# Pub/Sub push subscription for real-time developer notifications (authentication enabled).
RTDN_PUSH_AUDIENCE=https://iap.example.com/v1/rtdn/google-play
RTDN_PUSH_SERVICE_ACCOUNT=rtdn-push@PROJECT_ID.iam.gserviceaccount.com
RTDN_EXPECTED_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/play-rtdn-push

REQUIRE_OBFUSCATED_ACCOUNT_ID=false
# Needed while testing with license testers. Set to false before launch unless you want
# license-tester purchases (which cost nothing) to grant real items in production.
ALLOW_TEST_PURCHASES=true
# hold: leave invalid purchases unacknowledged (Google refunds them after 3 days).
# refund: refund and revoke them immediately through orders.refund. Moves money.
REJECTED_PURCHASE_POLICY=hold

RUN_BACKGROUND_JOBS=true
VERIFY_RATE_LIMIT_PER_MINUTE=30
