{
  "name": "game1",
  "private": true,
  "description": "Game1 games and the shared framework they are built on.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
