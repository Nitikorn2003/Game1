# Copy this file to .env.production.local (git ignores it) to build the Android app against your
# own services. None of these values is a secret, since anyone who has the app can read them,
# but they stay out of the public repository. See ANDROID.md.

# The purchase server (services/iap-server), https only. Without it the app has no sign-in,
# cloud saves or purchases.
VITE_IAP_SERVER_URL=

# AdMob ad units (AdMob, Apps, Ad units). Until both are set the app shows Google's test ads.
VITE_ADMOB_REWARDED_UNIT=
VITE_ADMOB_INTERSTITIAL_UNIT=
