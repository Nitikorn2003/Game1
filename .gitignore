.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
*service-account*.json
*credentials*.json

# Game workspaces (packages/, games/, tools/).
node_modules/
dist/
dist-single/
coverage/
test-results/
playwright-report/
